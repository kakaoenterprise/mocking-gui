{
  "openapi": "3.0.3",
  "info": {
    "title": "Mocking GUI Demo API (v2)",
    "version": "2.0.0",
    "description": "Imported at runtime by the Swagger tab. Handlers below are generated from this document, not written by hand."
  },
  "servers": [{ "url": "https://api.mocking-gui.demo/v2" }],
  "paths": {
    "/projects": {
      "get": {
        "summary": "List projects",
        "responses": {
          "200": {
            "description": "A page of projects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Project" }
                    },
                    "total": { "type": "integer", "example": 2 }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Caller lacks project:read",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/projects/{project-id}": {
      "get": {
        "summary": "Get a project",
        "description": "The kebab-case path parameter is intentional - it is normalized on import.",
        "parameters": [
          {
            "name": "project-id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The project",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Project" }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Project": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "prj_31" },
          "name": { "type": "string", "example": "checkout-web" },
          "region": { "type": "string", "example": "kr-central-2" },
          "status": { "type": "string", "example": "running" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "FORBIDDEN" },
              "message": { "type": "string", "example": "Missing scope." }
            }
          }
        }
      }
    }
  }
}
