{
  "name": "mocking-gui-monorepo",
  "version": "1.0.0",
  "description": "A GUI library that provides an MSW-based mocking panel",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kakaoenterprise/mocking-gui.git"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,js,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,js,mjs,cjs}\"",
    "mocking-gui:build": "pnpm --filter @kakaocloud/mocking-gui build",
    "example:dev": "pnpm turbo watch dev --filter='./examples/*'",
    "docs:dev": "pnpm --filter @mocking-gui/docs dev",
    "docs:build": "pnpm --filter @mocking-gui/docs build",
    "docs:preview": "pnpm --filter @mocking-gui/docs preview",
    "docs:deploy": "pnpm --filter @mocking-gui/docs deploy",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "prepare": "husky",
    "release": "pnpm --filter @kakaocloud/mocking-gui release"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "26.6.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "turbo": "2.10.13"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9"
}
