{
  // Typechecks the test files that tsconfig.json deliberately excludes (they must
  // not be emitted into dist). Scoped to src/api because that is where
  // `@ts-expect-error` is used as an assertion: if a compile-time guarantee
  // regresses, the directive becomes unused and this config fails. We also include
  // src/vite-env.d.ts to supply the CSS/asset module declarations needed when a
  // surface test references the browser entry's types.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/api/**/*", "src/__tests__/**/*", "src/vite-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
